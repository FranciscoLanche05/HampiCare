<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!--
    Estructura: StackPane de fondo que llena TODA la ventana, con una
    tarjeta (login-card) de tamaño fijo centrada adentro — así se ve
    bien sin importar el tamaño/proporción de la ventana.
-->
<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.hampicare.controller.LoginController"
           styleClass="login-backdrop"
           stylesheets="@../css/styles.css">

    <HBox styleClass="login-card" maxWidth="900" maxHeight="560" prefWidth="900" prefHeight="560">

        <!-- ===== Columna izquierda: marca ===== -->
        <StackPane HBox.hgrow="ALWAYS" prefWidth="400" maxWidth="400">
            <ImageView fitWidth="400" fitHeight="560" preserveRatio="false">
                <image>
                    <Image url="@../images/fondo2.jpg"/>
                </image>
            </ImageView>
            <VBox styleClass="login-aside-overlay" spacing="14" alignment="CENTER">
                <ImageView fitWidth="190" preserveRatio="true">
                    <image>
                        <Image url="@../images/logo.png"/>
                    </image>
                </ImageView>
                <Region VBox.vgrow="ALWAYS"/>
                <Label text="🔒 Sesión cifrada de extremo a extremo" styleClass="login-foot"/>
            </VBox>
        </StackPane>

        <!-- ===== Columna derecha: formulario ===== -->
        <VBox styleClass="login-main" alignment="CENTER" HBox.hgrow="ALWAYS" prefWidth="500">
            <VBox spacing="18" maxWidth="330">
                <VBox spacing="4">
                    <Label text="Iniciar sesión" styleClass="login-title"/>
                    <Label text="Entorno operativo seguro" styleClass="login-subtitle"/>
                </VBox>

                <VBox spacing="7">
                    <Label text="Selecciona tu rol" styleClass="field-label"/>
                    <HBox spacing="6" styleClass="role-selector">
                        <fx:define>
                            <ToggleGroup fx:id="rolToggleGroup"/>
                        </fx:define>
                        <ToggleButton fx:id="rolAdminToggle" text="Administrador" styleClass="role-toggle"
                                      toggleGroup="$rolToggleGroup" userData="ADMIN" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        <ToggleButton fx:id="rolCajeroToggle" text="Cajero" styleClass="role-toggle"
                                      toggleGroup="$rolToggleGroup" userData="CAJERO" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        <ToggleButton fx:id="rolReportesToggle" text="Reportes" styleClass="role-toggle"
                                      toggleGroup="$rolToggleGroup" userData="REPORTES" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    </HBox>
                </VBox>

                <VBox spacing="7">
                    <Label text="Correo" styleClass="field-label"/>
                    <TextField fx:id="usuarioField" styleClass="input-field" promptText="admin@hampipharma.com"/>
                </VBox>

                <VBox spacing="7">
                    <Label text="Contraseña" styleClass="field-label"/>
                    <PasswordField fx:id="contrasenaField" styleClass="input-field" promptText="Ingresa tu contraseña"/>
                </VBox>

                <Button text="Ingresar  →" styleClass="btn-primary" maxWidth="Infinity"
                        onAction="#handleLogin"/>

                <Label text="🛡 Acceso restringido a personal autorizado" styleClass="secure-note"
                       wrapText="true"/>

                <Label text="Prueba: selecciona un rol e ingresa admin@hampipharma.com / cajero@hampipharma.com / reportes@hampipharma.com (clave: 123456)"
                       styleClass="secure-note" wrapText="true" style="-fx-font-style: italic;"/>
            </VBox>
        </VBox>

    </HBox>
</StackPane>