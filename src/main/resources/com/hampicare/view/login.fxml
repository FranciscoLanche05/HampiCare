<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<!--
    Estructura: StackPane de fondo que llena TODA la ventana, con una
    tarjeta (login-card) de tamaño fijo centrada adentro — así se ve
    bien sin importar el tamaño/proporción de la ventana.
-->

<StackPane styleClass="login-backdrop" stylesheets="@../css/styles.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.hampicare.controller.LoginController">

    <HBox maxHeight="560" maxWidth="900" prefHeight="560" prefWidth="900" styleClass="login-card">

        <!-- ===== Columna izquierda: marca ===== -->
        <VBox alignment="CENTER" prefWidth="400" spacing="14" styleClass="login-aside" HBox.hgrow="ALWAYS">
            <ImageView fitWidth="190" preserveRatio="true">
                <image>
                    <Image url="@../images/logo.png" />
                </image>
            </ImageView>
            <Region VBox.vgrow="ALWAYS" />
            <Label styleClass="login-foot" text="🔒 Sesión cifrada de extremo a extremo" />
        </VBox>

        <!-- ===== Columna derecha: formulario ===== -->
        <VBox alignment="CENTER" prefWidth="500" styleClass="login-main" HBox.hgrow="ALWAYS">
            <VBox maxWidth="330" spacing="18">
                <VBox spacing="4">
                    <Label styleClass="login-title" text="Iniciar sesión" />
                    <Label styleClass="login-subtitle" text="Entorno operativo seguro" />
                </VBox>

                <VBox spacing="7">
                    <Label styleClass="field-label" text="Selecciona tu rol" />
                    <HBox spacing="6" styleClass="role-selector">
                        <fx:define>
                            <ToggleGroup fx:id="rolToggleGroup" />
                        </fx:define>
                        <ToggleButton fx:id="rolAdminToggle" maxWidth="Infinity" styleClass="role-toggle" text="Administrador" userData="ADMIN" HBox.hgrow="ALWAYS">
                     <toggleGroup>
                        <ToggleGroup fx:id="rolToggleGroup" />
                     </toggleGroup></ToggleButton>
                        <ToggleButton fx:id="rolCajeroToggle" maxWidth="Infinity" styleClass="role-toggle" text="Cajero" toggleGroup="$rolToggleGroup" userData="CAJERO" HBox.hgrow="ALWAYS" />
                        <ToggleButton fx:id="rolReportesToggle" maxWidth="Infinity" styleClass="role-toggle" text="Reportes" toggleGroup="$rolToggleGroup" userData="REPORTES" HBox.hgrow="ALWAYS" />
                    </HBox>
                </VBox>

                <VBox spacing="7">
                    <Label styleClass="field-label" text="Correo" />
                    <TextField fx:id="usuarioField" promptText="admin@hampipharma.com" styleClass="input-field" />
                </VBox>

                <VBox spacing="7">
                    <Label styleClass="field-label" text="Contraseña" />
                    <PasswordField fx:id="contrasenaField" promptText="Ingresa tu contraseña" styleClass="input-field" />
                </VBox>

                <Button maxWidth="Infinity" onAction="#handleLogin" styleClass="btn-primary" text="Ingresar  →" />

                <Label styleClass="secure-note" text="🛡 Acceso restringido a personal autorizado" wrapText="true" />

                <Label style="-fx-font-style: italic;" styleClass="secure-note" text="Prueba: selecciona un rol e ingresa admin@hampipharma.com / cajero@hampipharma.com / reportes@hampipharma.com (clave: 123456)" wrapText="true" />
            </VBox>
        </VBox>

    </HBox>
</StackPane>
